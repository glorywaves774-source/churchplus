# Copy to .env for local development. Never commit .env.
# Which configuration to load: development | testing | production
APP_ENV=development
FLASK_APP=run.py

# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL. Leave empty in development to use a local SQLite file in instance/.
# Render provides this automatically from the linked database.
DATABASE_URL=

# Set to true whenever the site is served over HTTPS (always in production).
SESSION_COOKIE_SECURE=false
SESSION_HOURS=12

# File storage: local (private folder in instance/) or s3 (any S3-compatible store)
STORAGE_BACKEND=local
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Rate limiting store. Use a Redis URL in production with several instances.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per minute

DEFAULT_CURRENCY=GHS
DEFAULT_TIMEZONE=Africa/Accra
LOG_LEVEL=INFO

# Used only by `flask churchplus create-superadmin` if set (otherwise you are prompted).
SUPERADMIN_PASSWORD=

# Optional: run the test suite against PostgreSQL instead of in-memory SQLite.
TEST_DATABASE_URL=

# Accounts and email
REGISTRATION_REQUIRES_APPROVAL=false
PUBLIC_BASE_URL=
MAIL_BACKEND=console
MAIL_FROM=ChurchPlus <no-reply@yourdomain.com>
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_STARTTLS=true

# Field encryption (two-step sign-in keys). Optional; derived from SECRET_KEY when empty.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Church messaging (Stage 8). console = nothing leaves the server (development).
SMS_BACKEND=console
SMS_DEFAULT_SENDER=ChurchPlus
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
ARKESEL_API_KEY=
WHATSAPP_BACKEND=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSAGES_SEND_NOW_LIMIT=100

# ChurchPlus subscription payments (Stage 10). No card data is ever stored.
BILLING_PROVIDERS=paystack,hubtel
PAYSTACK_SECRET_KEY=
HUBTEL_PAY_CLIENT_ID=
HUBTEL_PAY_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
BILLING_GRACE_DAYS=7
